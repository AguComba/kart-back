{
  "name": "karting-session-logbook",
  "version": "0.1.0",
  "description": "Karting Session Logbook backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migration:generate": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:generate src/infrastructure/database/migrations/GeneratedMigration",
    "migration:run": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/infrastructure/database/data-source.ts migration:revert",
    "seed": "ts-node src/infrastructure/database/seeds/seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^3.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.7.4",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
